---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Después de los 40 - El podcast más tuanis de Costa Rica donde hablamos de todo lo que nos pasa después de los 40" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/Logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-white">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
