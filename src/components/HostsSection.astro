---
const hosts = [
  {
    name: 'Tavo',
    role: 'Creador Digital y Comediante',
    color: '#EF4136',
    image: '/images/TavoGamboa.jpg',
    description: 'Creador digital costarricense, esposo comprometido, papá todoterreno y comediante de vocación. Tavo mezcla humor, realidad y picardía tica para contar historias con las que cualquiera se identifica.',
    instagram: 'https://instagram.com/tavogamboa',
    tiktok: 'https://tiktok.com/@tavogamboa',
  },
  {
    name: 'Vicky',
    role: 'Periodista, Locutora y Presentadora',
    color: '#F57876',
    image: '/images/VictoriaFuentes.jpg',
    description: 'Comunicadora costarricense con micrófono en el corazón y café en la vena. Periodista, locutora comercial y presentadora. Esposa, mamá de dos y mamá perruna, experta en contar historias reales con voz, criterio y buen humor.',
    instagram: 'https://instagram.com/vickyfuentes',
    tiktok: 'https://tiktok.com/@vickyfuentes',
  },
  {
    name: 'Jair',
    role: 'Locutor, Presentador y Animador',
    color: '#29B1E3',
    image: '/images/JairCruz.jpg',
    description: 'Locutor en 95.9, rostro de TV, presentador y animador de eventos. Jair hace de todo un poco… y lo hace hablando, improvisando y conectando con la gente. Si hay micrófono, hay historia; si hay público, hay show.',
    instagram: 'https://instagram.com/jaircruz',
    tiktok: 'https://tiktok.com/@jaircruz',
  },
];
---

<section id="nosotros" class="w-full bg-white py-12 md:py-16 lg:py-20 px-4 md:px-8 lg:px-20 hosts-section">
  <div class="max-w-7xl mx-auto flex flex-col items-center gap-8 md:gap-12">
    <!-- Header -->
    <div class="flex flex-col items-center gap-3 md:gap-4 text-center hosts-header">
      <span class="text-accent font-bold tracking-widest text-xs md:text-sm">CONOCÉ A</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-primary font-heading">Los Chichis</h2>
      <p class="text-gray-500 text-sm md:text-lg max-w-md md:max-w-none">Tres chichis hablando con humor de todo lo que pasa cuando cruzás los 40</p>
    </div>

    <!-- Hosts Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {hosts.map((host, index) => (
        <div class="host-card flex flex-col items-center gap-4 md:gap-6 text-center group" data-index={index}>
          <div
            class="w-[150px] h-[150px] md:w-[180px] md:h-[180px] lg:w-[200px] lg:h-[200px] rounded-full overflow-hidden transition-all duration-500 group-hover:scale-110"
            style={`box-shadow: 0 8px 24px ${host.color}40; border: 4px solid ${host.color};`}
          >
            <img
              src={host.image}
              alt={host.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-primary font-heading group-hover:scale-105 transition-transform duration-300">{host.name}</h3>
          <p class="text-xs md:text-sm font-normal transition-all duration-300" style={`color: ${host.color};`}>{host.role}</p>
          <p class="text-gray-500 text-xs md:text-sm leading-relaxed max-w-[280px] md:max-w-[300px]">{host.description}</p>
          <div class="flex gap-2">
            <a href={host.instagram} target="_blank" class="p-2 rounded-full bg-gray-100 hover:bg-gray-200 transition-all duration-300 hover:scale-110 hover:rotate-6">
              <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a href={host.tiktok} target="_blank" class="p-2 rounded-full bg-gray-100 hover:bg-gray-200 transition-all duration-300 hover:scale-110 hover:-rotate-6">
              <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const hostsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const header = entry.target.querySelector('.hosts-header');
        if (header) {
          (header as HTMLElement).style.opacity = '1';
          (header as HTMLElement).style.transform = 'translateY(0)';
        }

        const cards = entry.target.querySelectorAll('.host-card');
        cards.forEach((card, index) => {
          setTimeout(() => {
            (card as HTMLElement).style.opacity = '1';
            (card as HTMLElement).style.transform = 'translateY(0) scale(1)';
          }, 200 + index * 200);
        });
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.hosts-section').forEach(section => {
    hostsObserver.observe(section);

    const header = section.querySelector('.hosts-header');
    if (header) {
      (header as HTMLElement).style.opacity = '0';
      (header as HTMLElement).style.transform = 'translateY(30px)';
      (header as HTMLElement).style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    }

    section.querySelectorAll('.host-card').forEach(card => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(50px) scale(0.9)';
      (card as HTMLElement).style.transition = 'opacity 0.7s ease, transform 0.7s ease';
    });
  });
</script>
