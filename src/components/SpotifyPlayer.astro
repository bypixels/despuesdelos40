---
interface Props {
  showId?: string;
  episodeId?: string;
  theme?: 'dark' | 'light';
  compact?: boolean;
}

const {
  showId = '4rOoJ6Egrf8K2IrywzwOMk', // Placeholder - replace with actual show ID
  episodeId,
  theme = 'dark',
  compact = false
} = Astro.props;

// Construct the embed URL
const embedUrl = episodeId
  ? `https://open.spotify.com/embed/episode/${episodeId}?utm_source=generator&theme=${theme === 'dark' ? '0' : '1'}`
  : `https://open.spotify.com/embed/show/${showId}?utm_source=generator&theme=${theme === 'dark' ? '0' : '1'}`;

const height = compact ? '152' : '352';
---

<section class="w-full bg-gray-900 py-12 md:py-16 lg:py-20 px-4 md:px-8 lg:px-20">
  <div class="max-w-4xl mx-auto flex flex-col items-center gap-6 md:gap-8">
    <div class="flex flex-col items-center gap-3 md:gap-4 text-center">
      <span class="text-green-400 font-bold tracking-widest text-xs md:text-sm flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
        </svg>
        ESCUCHA EN SPOTIFY
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white font-heading">
        Último Episodio
      </h2>
      <p class="text-gray-400 text-sm md:text-base max-w-md">
        Escuchá el episodio más reciente directamente aquí o en tu app de Spotify
      </p>
    </div>

    <div class="w-full max-w-2xl rounded-xl overflow-hidden shadow-2xl">
      <iframe
        style="border-radius:12px"
        src={embedUrl}
        width="100%"
        height={height}
        frameBorder="0"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </div>

    <a
      href="https://open.spotify.com/show/example"
      target="_blank"
      class="flex items-center gap-2 text-green-400 hover:text-green-300 transition-colors text-sm md:text-base"
    >
      <span>Ver todos los episodios en Spotify</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </a>
  </div>
</section>
