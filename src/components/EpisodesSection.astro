---
interface Episode {
  id: number;
  episodeNumber: string;
  title: string;
  description: string;
  date: string;
  duration: string;
  image: string;
  tagColor: string;
  tagBgColor: string;
  spotifyUrl?: string;
}

const episodes: Episode[] = [
  {
    id: 1,
    episodeNumber: "Ep. 125",
    title: "¿Por qué me duele todo?",
    description: "Hablamos de esos dolores misteriosos que aparecen después de los 40. Rodillas, espalda, y el clásico: ¿por qué me levanté así?",
    date: "15 Ene 2026",
    duration: "45 min",
    image: "/images/FotoPortada.png",
    tagColor: "#E84A27",
    tagBgColor: "#E84A2722",
    spotifyUrl: "https://open.spotify.com/episode/example1",
  },
  {
    id: 2,
    episodeNumber: "Ep. 124",
    title: "Noches sin dormir",
    description: "Las 3am ya no son para fiesta, son para ir al baño. Compartimos tips y risas sobre el insomnio cuarentón.",
    date: "8 Ene 2026",
    duration: "52 min",
    image: "/images/FotoPortada.png",
    tagColor: "#29B1E3",
    tagBgColor: "#29ABE222",
    spotifyUrl: "https://open.spotify.com/episode/example2",
  },
  {
    id: 3,
    episodeNumber: "Ep. 123",
    title: "Lo que no te dijeron de los 40",
    description: "Esas cosas que nadie te advirtió: los lentes para leer, las canas rebeldes y por qué el ruido nos molesta más.",
    date: "1 Ene 2026",
    duration: "38 min",
    image: "/images/FotoPortada.png",
    tagColor: "#F7B500",
    tagBgColor: "#F7B50022",
    spotifyUrl: "https://open.spotify.com/episode/example3",
  },
];
---

<section class="w-full bg-gray-100 py-12 md:py-16 lg:py-20 px-4 md:px-8 lg:px-20 scroll-section" data-animate>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 md:mb-12 section-header">
      <div class="flex flex-col gap-2">
        <span class="text-accent font-bold tracking-widest text-xs md:text-sm">EPISODIOS</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-primary font-heading">Lo Más Reciente</h2>
      </div>
      <a href="/episodios" class="self-start sm:self-auto border-2 border-secondary text-secondary font-semibold px-4 md:px-6 py-2.5 md:py-3 rounded-full hover:bg-secondary hover:text-white transition-all duration-300 hover:scale-105 text-sm md:text-base">
        Ver Todos →
      </a>
    </div>

    <!-- Episodes Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {episodes.map((episode, index) => (
        <article
          class="episode-card bg-white rounded-2xl md:rounded-3xl overflow-hidden border border-gray-200 shadow-lg hover:shadow-2xl transition-all duration-500 group cursor-pointer hover-lift"
          style={`animation-delay: ${index * 0.15}s;`}
        >
          <div class="relative h-[180px] md:h-[200px] overflow-hidden img-zoom">
            <img
              src={episode.image}
              alt={episode.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <!-- Play Button Overlay -->
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="w-14 h-14 md:w-16 md:h-16 bg-secondary/90 rounded-full flex items-center justify-center shadow-lg transform scale-75 group-hover:scale-100 transition-transform duration-300">
                <svg class="w-6 h-6 md:w-7 md:h-7 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21"/>
                </svg>
              </div>
            </div>
          </div>
          <div class="p-4 md:p-6 flex flex-col gap-3 md:gap-4">
            <span
              class="inline-flex self-start px-2.5 md:px-3 py-1 md:py-1.5 rounded-lg md:rounded-xl text-[10px] md:text-xs font-semibold transition-transform duration-300 group-hover:scale-110"
              style={`color: ${episode.tagColor}; background-color: ${episode.tagBgColor};`}
            >
              {episode.episodeNumber}
            </span>
            <h3 class="text-lg md:text-xl font-bold text-primary font-heading group-hover:text-secondary transition-colors duration-300 line-clamp-2">
              {episode.title}
            </h3>
            <p class="text-gray-500 text-xs md:text-sm leading-relaxed line-clamp-2 md:line-clamp-3">
              {episode.description}
            </p>
            <div class="flex items-center justify-between text-xs mt-auto pt-2 border-t border-gray-100">
              <div class="flex items-center gap-3 md:gap-4">
                <span style={`color: ${episode.tagColor};`}>{episode.duration}</span>
                <span class="text-gray-400">{episode.date}</span>
              </div>
              <a
                href={episode.spotifyUrl}
                target="_blank"
                class="text-green-500 hover:text-green-600 transition-colors"
                aria-label="Escuchar en Spotify"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02z"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animated');
        const cards = entry.target.querySelectorAll('.episode-card');
        cards.forEach((card, index) => {
          setTimeout(() => {
            (card as HTMLElement).style.opacity = '1';
            (card as HTMLElement).style.transform = 'translateY(0)';
          }, index * 150);
        });
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.scroll-section').forEach(section => {
    observer.observe(section);
  });

  document.querySelectorAll('.episode-card').forEach(card => {
    (card as HTMLElement).style.opacity = '0';
    (card as HTMLElement).style.transform = 'translateY(30px)';
    (card as HTMLElement).style.transition = 'opacity 0.6s ease, transform 0.6s ease';
  });
</script>
