---
const sponsors = [
  { image: '/images/Bimbo1.jpg', alt: 'Patrocinador 1' },
  { image: '/images/Bimbo2.jpg', alt: 'Patrocinador 2' },
  { image: '/images/Bimbo3.jpg', alt: 'Patrocinador 3' },
];
---

<section class="w-full bg-gray-100 py-12 md:py-16 px-4 md:px-8 lg:px-20">
  <div class="max-w-7xl mx-auto flex flex-col items-center gap-6 md:gap-8">
    <span class="text-gray-400 font-bold tracking-widest text-[10px] md:text-xs">NUESTROS PATROCINADORES</span>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 lg:gap-8 w-full">
      {sponsors.map((sponsor) => (
        <div class="w-full aspect-square max-w-[400px] mx-auto rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
          <img
            src={sponsor.image}
            alt={sponsor.alt}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>
