---
---

<section class="flex flex-col lg:flex-row w-full min-h-[600px] lg:h-[600px] overflow-hidden">
  <!-- Hero Content -->
  <div class="w-full lg:w-1/2 flex flex-col justify-center gap-4 md:gap-6 p-6 md:p-12 lg:p-20 bg-gradient-to-b from-white to-[#F8F8FF] order-2 lg:order-1">
    <div class="inline-flex animate-fade-in-up" style="opacity: 0; animation-delay: 0.1s;">
      <span class="inline-flex items-center px-3 py-1.5 rounded-[20px] text-[10px] md:text-[11px] font-bold tracking-[2px] text-accent bg-accent/15 border border-accent">
        🎙️ ¡HOLA CHICHIS!
      </span>
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[56px] font-extrabold text-primary font-heading leading-tight animate-fade-in-up" style="opacity: 0; animation-delay: 0.2s;">
      Después de los 40
    </h1>

    <p class="text-lg md:text-xl lg:text-2xl font-semibold text-secondary font-heading animate-fade-in-up" style="opacity: 0; animation-delay: 0.3s;">
      Con Jair - Vicky - Tavo
    </p>

    <p class="text-sm md:text-base text-gray-500 leading-[1.6] max-w-[480px] animate-fade-in-up" style="opacity: 0; animation-delay: 0.4s;">
      El podcast más tuanis de Costa Rica donde hablamos de todo lo que nos pasa después de los 40: dolores de rodilla, noches sin dormir, y esas cosas que solo los chichis entendemos. ¡Pura vida y risas!
    </p>

    <div class="inline-flex animate-fade-in-up" style="opacity: 0; animation-delay: 0.5s;">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 md:px-3.5 md:py-2 rounded-[20px] text-[10px] md:text-[11px] font-bold tracking-[1px] text-red-500 bg-red-500/10 border border-red-500 animate-pulse-slow">
        <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/>
          <polygon fill="white" points="9.545,15.568 15.818,12 9.545,8.432"/>
        </svg>
        Todos los martes a las 8 pm en YouTube
      </span>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 md:gap-4 mt-2 animate-fade-in-up" style="opacity: 0; animation-delay: 0.6s;">
      <a href="/episodios" class="btn-shine inline-flex items-center justify-center gap-2 md:gap-3 bg-secondary text-white font-semibold text-sm md:text-base px-6 md:px-8 py-3 md:py-4 rounded-[30px] shadow-lg hover:shadow-xl transition-all hover:scale-105 hover-glow" style="box-shadow: 0 4px 16px rgba(239, 65, 54, 0.3);">
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="currentColor" viewBox="0 0 24 24">
          <polygon points="5,3 19,12 5,21"/>
        </svg>
        Último Episodio
      </a>
      <a href="https://open.spotify.com/show/36N3lKvjI1jBxOjbzoO9sD" target="_blank" class="inline-flex items-center justify-center gap-2 md:gap-3 border-2 border-accent text-accent font-semibold text-sm md:text-base px-6 md:px-8 py-3 md:py-4 rounded-[30px] hover:bg-accent hover:text-white transition-all duration-300">
        Spotify
      </a>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="w-full lg:w-1/2 h-[300px] sm:h-[400px] lg:h-full animate-fade-in-right order-1 lg:order-2" style="opacity: 0; animation-delay: 0.3s;">
    <img
      src="/images/FotoPortada.png"
      alt="Después de los 40 - Podcast"
      class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
      loading="eager"
    />
  </div>
</section>
