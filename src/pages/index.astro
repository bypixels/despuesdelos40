---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import SponsorBanner from '../components/SponsorBanner.astro';
import EpisodesSection from '../components/EpisodesSection.astro';
import SpotifyPlayer from '../components/SpotifyPlayer.astro';
import SponsorsSection from '../components/SponsorsSection.astro';
import HostsSection from '../components/HostsSection.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import CTASection from '../components/CTASection.astro';
import ContactSection from '../components/ContactSection.astro';
import PlatformsSection from '../components/PlatformsSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Después de los 40 | El Podcast más Tuanis de Costa Rica">
  <Header currentPage="home" />
  <main>
    <HeroSection />
    <SponsorBanner />
    <EpisodesSection />
    <SpotifyPlayer />
    <SponsorsSection />
    <HostsSection />
    <NewsletterSection />
    <CTASection />
    <ContactSection />
    <PlatformsSection />
  </main>
  <Footer />
</Layout>
